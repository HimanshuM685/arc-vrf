# ---- Node (pnpm node) ----
RPC_URL=https://rpc.testnet.arc.io
# VRF proving key: only proves, never signs transactions. Keep it in a KMS/HSM before mainnet.
VRF_PROVING_KEY=
# Pays gas for fulfilments (needs testnet USDC from https://faucet.circle.com)
NODE_TX_KEY=
# Optional: defaults to the deployment block from contracts/deployments/<chainId>.json
START_BLOCK=
POLL_MS=500
MIN_BALANCE_USDC=1
# COORDINATOR=0x...   # override the address from contracts/deployments

# ---- Deploy (pnpm --filter @arc-vrf/node deploy) ----
DEPLOYER_KEY=
# Either the public key (x,y as decimal or hex) or VRF_PROVING_KEY above
VRF_PUBLIC_KEY=
PREMIUM_PCT=50
WRAPPER_PREMIUM_PCT=60
FLAT_FEE_PPM=0
MAX_GAS_PRICE_GWEI=500
WRAPPER_FUNDING_USDC=1
EXAMPLE_FUNDING_USDC=0.5
