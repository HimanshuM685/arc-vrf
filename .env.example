# Copy to .env (or run `make keys`, which creates it with fresh keys).
# Never commit .env. Never paste these keys anywhere.

# ============ RUNTIME: used by `make up` ============

# Arc RPC. Comma-separate several for failover, first is preferred:
#   https://rpc.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io
RPC_URL=https://rpc.testnet.arc.io

# VRF proving key: computes the randomness. Never funded, never sends transactions.
VRF_PROVING_KEY=
# Pays gas for answers. Fund with ~1 USDC (https://faucet.circle.com on testnet).
NODE_TX_KEY=

# Optional overrides. Leave empty to use the deployment file for the chain.
# COORDINATOR=0x...
# START_BLOCK=0

# Optional: Discord or Slack incoming-webhook URL for alerts
# (low gas balance, RPC outage + recovery, a request failing repeatedly, node restarts).
ALERT_WEBHOOK_URL=
# Alert when the node's gas balance drops below this many USDC.
MIN_BALANCE_USDC=1

# Website: port it is published on. Change it, then run `make up`.
WEB_PORT=3000
# Optional: enables WalletConnect / mobile wallets in the connect modal (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ============ DEPLOY ONLY: used by `make deploy-contracts`. Remove DEPLOYER_KEY after deploying ============

# Deploys and owns the contracts (sets fees, withdraws earnings). Fund with ~3 USDC.
DEPLOYER_KEY=
PREMIUM_PCT=50
WRAPPER_PREMIUM_PCT=60
FLAT_FEE_PPM=0
MAX_GAS_PRICE_GWEI=500
WRAPPER_FUNDING_USDC=1
EXAMPLE_FUNDING_USDC=0.5
