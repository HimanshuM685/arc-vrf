# Copy to apps/web/.env.local for `pnpm dev`.
# Optional: enables WalletConnect / MetaMask mobile in the connect modal (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Alchemy URLs for the /api/rpc proxy. Server-side only (no NEXT_PUBLIC_ prefix): never sent to browsers.
# Needed to use Arc Testnet in dev; the local anvil chain works without them.
ARC_TESTNET_RPC_URL=https://arc-testnet.g.alchemy.com/v2/YOUR_DASHBOARD_KEY
ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545
# Show the local anvil chain in production builds
NEXT_PUBLIC_SHOW_LOCAL=
