{
  "name": "@arc-vrf/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "register-key": "tsx src/cli/register-key.ts",
    "e2e": "tsx scripts/e2e.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy-contracts": "tsx scripts/deploy.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/vrf-node.mjs",
    "new-keys": "tsx scripts/new-keys.ts"
  },
  "dependencies": {
    "@arc-vrf/sdk": "workspace:*",
    "@noble/curves": "2.4.0",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
